# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-astatine-juneberry"
CONFIG_ARCH_MMAP_RND_BITS=20
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_HTCP is not set
CONFIG_DEFAULT_WESTWOOD=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_TCP_CONG_WESTWOOD=y
# The module packaging strips the modules after the kernel build, which drops an
# appended signature, so a signed module would be rejected on the device.
# MODULE_SIG_PROTECT depends on this and goes with it.
# CONFIG_MODULE_SIG is not set
