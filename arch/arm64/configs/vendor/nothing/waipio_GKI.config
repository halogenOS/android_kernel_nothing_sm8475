CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_LOG_BUF_SHIFT=21

# CONFIG_INPUT_QCOM_HV_HAPTICS is not set
# CONFIG_QCOM_SPSS is not set
# CONFIG_RPMSG_QCOM_GLINK_SPSS is not set

# Disable debugging
# CONFIG_ARM_QCOM_CPUFREQ_HW_DEBUG is not set
# CONFIG_SPMI_MSM_PMIC_ARB_DEBUG is not set
# CONFIG_QTI_BATTERY_GLINK_DEBUG is not set
# CONFIG_INTERCONNECT_QCOM_DEBUG is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_PID_IN_CONTEXTIDR is not set
# CONFIG_CORESIGHT is not set
# CONFIG_KUNIT is not set

# Disable diwali chipset related configs

# Disable parrot chipset related configs
# CONFIG_INTERCONNECT_QCOM_PARROT is not set

# Nothing's own drivers
CONFIG_NT2_HWID=m
CONFIG_NT_SECURE_STATE=m
CONFIG_NT_SLOT_STATE=m
CONFIG_NOTHING_BOOTLOADER_LOG=m
CONFIG_NOTHING_RESTART_HANDLER=m
CONFIG_NOTHING_SECURE_ELEMENT=m
CONFIG_NOTHING_TASK_MEMINFO=m
CONFIG_NOTHING_SIMULATED_NTC=m
CONFIG_NOTHING_WRITRBACK_KMSG=y
CONFIG_GOODIX_FINGERPRINT=m
CONFIG_AWINIC_HAPTIC_HV=m
CONFIG_LEDS_AW20036=m
# CONFIG_INPUT_QCOM_HV_HAPTICS is not set
