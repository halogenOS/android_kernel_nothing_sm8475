CONFIG_CMA_DEBUGFS=n
CONFIG_PAGE_OWNER=n
CONFIG_PAGE_PINNER=n

# debugfs is compiled in but inert: it is not registered as a filesystem and
# clients get -EPERM when they try to create nodes, which is the same posture
# as leaving DEBUG_FS unset.  It has to be built, though, because SCHED_DEBUG
# depends on it and the 202404 kernel FCM - the first one that knows about
# 6.6 - requires SCHED_DEBUG.
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_NONE=y
CONFIG_SCHED_DEBUG=y

# Everything below merely depends on DEBUG_FS and switched itself on once it
# was built.  None of it was present while DEBUG_FS was off, and every driver
# that uses it does so conditionally, so turning it back off restores exactly
# the previous behaviour and keeps the delta to SCHED_DEBUG alone.
# CONFIG_IPC_LOGGING is not set
# CONFIG_USB_F_FS_IPC_LOGGING is not set
# CONFIG_REGMAP_QTI_DEBUGFS is not set
# CONFIG_REGULATOR_DEBUG_CONTROL is not set
# CONFIG_QCOM_IOMMU_DEBUG is not set
# CONFIG_QCOM_CPUSS_SLEEP_STATS is not set
# CONFIG_QTI_CHARGER_ULOG_GLINK is not set
# CONFIG_BLK_DEBUG_FS is not set
# CONFIG_BT_DEBUGFS is not set

# Exposes the interconnect API to userspace for testing and only became
# reachable once DEBUG_FS was built; it also no longer compiles, as it still
# calls icc_get() which 6.6 dropped.
# CONFIG_INTERCONNECT_TEST is not set
